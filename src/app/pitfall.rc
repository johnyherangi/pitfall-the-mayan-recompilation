    CONTROL "Generic1", IDC_WAVVOLUME, TRACKBAR_CLASS, TBS_VERT | TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 176, 49, 17, 55
    CONTROL "Generic1", IDC_CDVOLUME, TRACKBAR_CLASS, TBS_VERT | TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 223, 49, 17, 55
    CONTROL "Sound", -1, "Button", BS_GROUPBOX, 14, 17, 239, 101
    CONTROL "CD Audio", -1, "Static", SS_LEFT | WS_GROUP, 208, 39, 32, 9
    CONTROL "Sound Effects", -1, "Static", SS_LEFT | WS_GROUP, 148, 39, 47, 8
    CONTROL "", IDC_ICON_SOUND, "Static", SS_ICON, 124, 57, 18, 20
    CONTROL "CD Music", IDC_CDMUSIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 27, 68, 77, 8
    CONTROL "CD Ambient Sounds", IDC_CDAMBIENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 27, 85, 77, 8
    CONTROL "", IDC_RAMP_WAV, "Static", SS_GRAYFRAME | NOT WS_VISIBLE, 157, 52, 13, 49
    CONTROL "", IDC_RAMP_CD, "Static", SS_GRAYFRAME | NOT WS_VISIBLE, 203, 52, 13, 49
END

