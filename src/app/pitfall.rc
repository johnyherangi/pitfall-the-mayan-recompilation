IDD_KEYBOARD DIALOG 22, 17, 270, 138
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Keyboard"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", IDC_KEY_UP, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 169, 34, 34, 12
    CONTROL "", IDC_KEY_DOWN, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 169, 64, 34, 12
    CONTROL "", IDC_KEY_LEFT, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 149, 49, 34, 12
    CONTROL "", IDC_KEY_RIGHT, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 188, 49, 34, 12
    CONTROL "", IDC_KEY_JUMP, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 75, 20, 40, 12
    CONTROL "", IDC_KEY_SHOOT, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 75, 36, 40, 12
    CONTROL "", IDC_KEY_WHIP, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 75, 52, 40, 12
    CONTROL "", IDC_KEY_SELECT, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 75, 68, 40, 12
    CONTROL "", IDC_ICON_KEYBOARD, "Static", SS_ICON, 143, 94, 18, 20
    CONTROL "Jump:", -1, "Static", SS_LEFT | WS_GROUP, 15, 22, 21, 8
    CONTROL "Shoot:", -1, "Static", SS_LEFT | WS_GROUP, 15, 38, 25, 8
    CONTROL "Whip:", -1, "Static", SS_LEFT | WS_GROUP, 15, 54, 25, 8
    CONTROL "Select Weapon:", -1, "Static", SS_LEFT | WS_GROUP, 15, 70, 55, 8
    CONTROL "Up", -1, "Static", SS_CENTER | WS_GROUP, 179, 23, 13, 8
    CONTROL "Down", -1, "Static", SS_CENTER | WS_GROUP, 175, 79, 20, 8
    CONTROL "Left", -1, "Static", SS_RIGHT | WS_GROUP, 126, 51, 19, 8
    CONTROL "Right", -1, "Static", SS_LEFT | WS_GROUP, 226, 51, 25, 8
    CONTROL "Configure Keys", -1, "Button", BS_GROUPBOX, 4, 8, 253, 116
    CONTROL " Enable Keyboard", IDC_ENABLE_KEYBOARD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 99, 69, 10
    CONTROL "Press the key you want to control the selected action.", -1, "Static", SS_LEFT | WS_GROUP, 15, 95, 109, 19
END

IDD_JOYSTICK DIALOG 22, 17, 269, 136
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "JoyStick"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", IDC_JOY_JUMP, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 195, 30, 40, 12
    CONTROL "", IDC_JOY_SHOOT, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 195, 51, 40, 12
    CONTROL "", IDC_JOY_WHIP, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 195, 72, 40, 12
    CONTROL "", IDC_JOY_SELECT, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 195, 93, 40, 12
    CONTROL "", IDC_ICON_JOYSTICK, "Static", SS_ICON, 126, 57, 18, 20
    CONTROL "Jump:", -1, "Static", SS_RIGHT | WS_GROUP, 159, 33, 28, 8
    CONTROL "Shoot:", -1, "Static", SS_RIGHT | WS_GROUP, 161, 53, 26, 8
    CONTROL "Whip:", -1, "Static", SS_RIGHT | WS_GROUP, 160, 73, 25, 8
    CONTROL "Select Weapon:", -1, "Static", SS_RIGHT | WS_GROUP, 130, 93, 57, 8
    CONTROL "Configure Buttons", -1, "Button", BS_GROUPBOX, 15, 14, 238, 107
    CONTROL "Press the joystick button you want control the selected action.\n\nYou may also assign various actions to the keyboard. ", -1, "Static", SS_LEFT | WS_GROUP, 33, 30, 77, 58
    CONTROL "  Enable Joystick", IDC_ENABLE_JOYSTICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 33, 93, 94, 10
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Pitfall: The Mayan Adventure (reconstruction)"
            VALUE "InternalName", "pitfall"
            VALUE "OriginalFilename", "pitfall.exe"
            VALUE "ProductName", "Pitfall: The Mayan Adventure"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
